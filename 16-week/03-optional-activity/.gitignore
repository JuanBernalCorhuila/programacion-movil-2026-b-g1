# Dependencias
node_modules/

# Archivos compilados
dist/
build/

# Secretos locales (el .env.example sí se sube)
.env
.env.production

# Llave de firma de la app y sus contraseñas: nunca se suben al repositorio
*.jks
*.keystore
keystore.properties

# Paquetes generados para la tienda (se entregan en la tienda, no en el repo)
*.aab
*.apk
app/android/app/release/

# Igual que en la raíz del repo
package-lock.json

# Archivos que genera Android Studio / Capacitor al abrir o compilar
app/android/.idea/
app/android/.kotlin/
app/android/.gradle/
app/android/local.properties
app/android/capacitor-cordova-android-plugins/
app/android/app/src/main/assets/
app/android/app/src/main/res/xml/config.xml
